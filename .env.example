# ============================================================
# SERVER-ONLY secrets. Never prefix these with VITE_.
# Never import these into src/ (browser) code.
#
# LOCAL DEV: copy this file to a root .env (already gitignored) and fill
# in real values. server/lib/loadLocalEnv.ts loads it automatically for
# local-only scripts (e.g. `npm run live-check`) — this never runs on
# Vercel, which injects env vars directly. `vercel dev` also loads .env
# itself, so nothing extra is needed for that workflow either.
# ============================================================

# Required. Read exclusively by server/ai/geminiClient.ts.
GEMINI_API_KEY=

# Optional model overrides (see server/ai/config.ts for defaults and the
# Phase 4 live-verification notes there — gemini-2.5-flash was retired by
# Google after this app was first built; gemini-3.6-flash is the
# confirmed-working replacement as of 2026-09-17).
GEMINI_ROOM_ANALYSIS_MODEL=gemini-3.6-flash
GEMINI_TILE_RECOMMENDATION_MODEL=gemini-3.6-flash
# NOTE: image generation requires the Google Cloud project behind this key
# to have image-generation quota/billing enabled — run `npm run live-check`
# after enabling it to confirm this model actually works for your account.
GEMINI_VISUALIZATION_MODEL=gemini-3.1-flash-image

# Optional timeout overrides in milliseconds.
GEMINI_ROOM_ANALYSIS_TIMEOUT_MS=50000
GEMINI_TILE_RECOMMENDATION_TIMEOUT_MS=15000
GEMINI_VISUALIZATION_TIMEOUT_MS=45000

# Required. Read exclusively by server/lib/supabaseServerClient.ts.
# This client bypasses Row Level Security — every server/db/* function
# still performs its own explicit ownership check.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# Razorpay (credit purchases). Read exclusively by server/billing/razorpay.ts.
# Get TEST-mode keys from the Razorpay Dashboard -> Settings -> API Keys
# (toggle "Test Mode" on first). Get the webhook secret from Settings ->
# Webhooks -> Add New Webhook, after pointing it at:
#   https://<your-deployment>/api/razorpayWebhook
# with these events enabled: payment.captured, payment.failed, refund.processed.
# Never use live keys until the full sandbox flow (checkout -> webhook ->
# credited balance) has been verified end to end.
# ============================================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional: credits charged per visualization generation. Defaults to 10.
GENERATION_CREDIT_COST=10

# ============================================================
# BROWSER-SAFE variables (frontend phase — not used by any code yet).
# The VITE_ prefix is what makes Vite expose these to the client bundle.
# Never put the service-role key or Gemini key behind a VITE_ name.
# ============================================================
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
